# BidCheck Environment Variables Configuration
# Copy this file to .env: cp .env.example .env

# Database configuration (default is SQLite; Postgres supported via standard connection string)
DATABASE_URL=sqlite:///data/bidcheck.db
DB_ECHO=false

# Extractor backend: "fake" (default, 100% offline using sidecar JSONs) | "llm" (OpenAI API)
EXTRACTOR=fake

# OpenAI settings (only required when EXTRACTOR=llm)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_TEMPERATURE=0.0

# Thresholds
CONFIDENCE_THRESHOLD=0.70
FUZZY_THRESHOLD=85
